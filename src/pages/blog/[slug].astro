---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import Ornament from '@/components/Ornament.astro';
import { brand, pandit, abs } from '@/data/business';
import {
  buildGraph, organizationSchema, personSchema,
  articleSchema, faqSchema, breadcrumbSchema,
} from '@/lib/schema';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const url = abs(`/blog/${entry.id}/`);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/blog/' },
  { name: d.title, url: `/blog/${entry.id}/` },
];

const services = await getCollection('services', ({ data }) => !data.draft);
const service = d.relatedService ? services.find((s) => s.id === d.relatedService) : undefined;

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = buildGraph(
  organizationSchema(),
  personSchema(),
  articleSchema({
    title: d.title,
    description: d.description,
    url,
    datePublished: d.publishDate.toISOString(),
    dateModified: (d.updatedDate ?? d.publishDate).toISOString(),
  }),
  d.faqs.length ? faqSchema(d.faqs, url) : null,
  breadcrumbSchema(crumbs),
);
---

<BaseLayout
  title={`${d.title} | ${brand.shortName}`}
  description={d.description}
  canonicalPath={`/blog/${entry.id}/`}
  jsonLd={jsonLd}
>
  <div class="container-page pt-8"><Breadcrumbs crumbs={crumbs} /></div>

  <article>
    <header class="pb-10 pt-10">
      <div class="container-page">
        <div class="container-prose">
          <p class="eyebrow enter">Article</p>
          <h1 class="display-lg enter enter-d1 mt-5">{d.title}</h1>

          <p class="lead-answer enter enter-d2">{d.leadAnswer}</p>

          <!-- Visible provenance: author + dates. Both a trust signal and an
               explicit freshness cue for search engines and AI crawlers. -->
          <div class="enter enter-d3 mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-6 text-[0.85rem] text-muted">
            <span>By <a class="font-semibold text-maroon underline underline-offset-4" href="/about-pandit-ji/">{pandit.name}</a></span>
            <span aria-hidden="true">·</span>
            <span>Published <time datetime={d.publishDate.toISOString()}>{fmt(d.publishDate)}</time></span>
            {d.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></span>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    <div class="pb-14">
      <div class="container-page">
        <div class="container-prose">
          <Ornament variant="rule" class="mb-11" />
          <div class="prose-shj"><Content /></div>
        </div>
      </div>
    </div>

    {d.faqs.length > 0 && (
      <section class="border-y border-line bg-paper-warm py-14">
        <div class="container-page">
          <div class="container-prose">
            <h2 class="display-md reveal mb-7">Common questions</h2>
            <FaqAccordion faqs={d.faqs} openFirst={false} />
          </div>
        </div>
      </section>
    )}
  </article>

  <section class="py-14">
    <div class="container-page">
      <div class="container-prose grid gap-8">
        {service && (
          <div class="card reveal p-7">
            <p class="eyebrow">Related consultation</p>
            <h2 class="mt-3 font-display text-[1.35rem]" style="font-variation-settings:'SOFT' 16,'opsz' 42">
              {service.data.title}
            </h2>
            <p class="mt-2.5 text-[0.94rem] leading-relaxed text-muted">{service.data.summary}</p>
            <a class="btn btn-primary mt-5" href={`/services/${service.id}/`}>Read more</a>
          </div>
        )}

        {all.length > 0 && (
          <div>
            <h2 class="display-md reveal">Continue reading</h2>
            <div class="mt-6 grid gap-3">
              {all.map((p) => (
                <a class="next-link reveal" href={`/blog/${p.id}/`}>
                  <span class="next-title">{p.data.title}</span>
                  <span class="next-desc">{p.data.description}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .next-link {
    display: grid; gap: 0.3rem;
    padding: 1.1rem 1.3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s var(--ease-out-soft);
  }
  .next-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-gold) 60%, transparent);
  }
  .next-title { font-weight: 650; color: var(--color-maroon); }
  .next-desc { font-size: 0.88rem; line-height: 1.55; color: var(--color-muted); }
</style>
