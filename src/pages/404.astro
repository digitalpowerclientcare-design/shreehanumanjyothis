---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Ornament from '@/components/Ornament.astro';
import { brand, locations } from '@/data/business';
---

<BaseLayout
  title={`Page not found | ${brand.shortName}`}
  description="The page you were looking for could not be found."
  canonicalPath="/404/"
  noindex
>
  <section class="section">
    <div class="container-page">
      <div class="mx-auto max-w-xl text-center">
        <Ornament variant="rule" class="mx-auto mb-8 max-w-[9rem]" />
        <p class="eyebrow justify-center">404</p>
        <h1 class="display-lg mt-5">This page could not be found</h1>
        <p class="mt-5 leading-relaxed text-ink-soft">
          The page may have moved, or the link may be out of date.
          Here is where most people are heading.
        </p>

        <div class="mt-9 grid gap-3 sm:grid-cols-3">
          {locations.map((l) => (
            <a class="btn btn-outline" href={`/${l.slug}/`}>{l.city}</a>
          ))}
        </div>

        <div class="mt-4 flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href="/services/">All services</a>
          <a class="btn btn-outline" href="/contact/">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
