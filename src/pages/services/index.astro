---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { brand, abs } from '@/data/business';
import { buildGraph, organizationSchema, websiteSchema, personSchema, breadcrumbSchema } from '@/lib/schema';

const services = (await getCollection('services', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }];

const jsonLd = buildGraph(
  organizationSchema(),
  websiteSchema(),
  personSchema(),
  breadcrumbSchema(crumbs),
  {
    '@type': 'CollectionPage',
    '@id': `${abs('/services/')}#collection`,
    name: 'Astrology & Vastu Consultation Services',
    url: abs('/services/'),
    isPartOf: { '@id': abs('/#website') },
    hasPart: services.map((s) => ({
      '@type': 'Service',
      name: s.data.title,
      url: abs(`/services/${s.id}/`),
    })),
  },
);
---

<BaseLayout
  title={`Astrology & Vastu Services | ${brand.name}`}
  description="All consultation services offered by Pandit Sri Pandu Ranga Shastri Ji — Kundli matching, birth chart analysis, Vastu, Muhurtha, career guidance and traditional remedies."
  canonicalPath="/services/"
  jsonLd={jsonLd}
>
  <div class="container-page pt-8"><Breadcrumbs crumbs={crumbs} /></div>

  <section class="section pt-10">
    <div class="container-page">
      <SectionHeading
        eyebrow="Consultations"
        title="Astrology & Vastu consultation services"
        as="h1"
        lead="Every service below is available at all three centres — Bengaluru, Hyderabad and Mumbai — and online. Remedies are suggested only where a chart indicates them."
        class="mb-14 max-w-3xl"
      />

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <ServiceCard
            title={s.data.title}
            summary={s.data.summary}
            href={`/services/${s.id}/`}
            icon={s.data.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
