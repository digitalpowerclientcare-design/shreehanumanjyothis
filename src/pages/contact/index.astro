---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ClickToLoadMap from '@/components/ClickToLoadMap.astro';
import { brand, locations, telLink, whatsappLink, abs } from '@/data/business';
import { buildGraph, organizationSchema, websiteSchema, personSchema, localBusinessSchema, breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }];

const jsonLd = buildGraph(
  organizationSchema(true),
  websiteSchema(),
  personSchema(),
  ...locations.map(localBusinessSchema),
  breadcrumbSchema(crumbs),
  {
    '@type': 'ContactPage',
    '@id': `${abs('/contact/')}#contactpage`,
    url: abs('/contact/'),
    isPartOf: { '@id': abs('/#website') },
    about: { '@id': abs('/#organization') },
  },
);
---

<BaseLayout
  title={`Contact | ${brand.shortName} — Call or WhatsApp`}
  description="Contact Sri Hanuman Jyothishalaya. Call or message on WhatsApp for a consultation — Hyderabad (Kukatpally) plus Bengaluru and Mumbai centres. Fees shared before anything is booked."
  canonicalPath="/contact/"
  jsonLd={jsonLd}
  hideStickyCta
>
  <div class="container-page pt-8"><Breadcrumbs crumbs={crumbs} /></div>

  <section class="pb-14 pt-10">
    <div class="container-page">
      <SectionHeading
        eyebrow="Get in touch"
        title="Book a consultation"
        as="h1"
        lead="The quickest route is a call or WhatsApp — send your birth details (date, time and place, if known) and the chart is prepared before your appointment. Fees are always shared before anything is booked."
        class="max-w-3xl"
      />
    </div>
  </section>

  <!-- ============ TALK NOW (call-first) ============ -->
  <section class="pb-16">
    <div class="container-page">
      <div class="mx-auto max-w-xl text-center card p-8 sm:p-10">
        <p class="eyebrow">The quickest way</p>
        <h2 class="mt-2.5 font-display text-[1.6rem]">Talk to us now</h2>
        <p class="mt-3 text-faint">Consultations in Telugu, Hindi, Kannada &amp; English — in person or online. No guaranteed outcomes; guidance is offered for clarity and perspective.</p>
        <div class="mx-auto mt-7 grid max-w-sm gap-3">
          <a class="btn btn-gold !min-h-12" href={telLink(locations[0])} data-cta="call">Call {locations[0].phoneDisplay}</a>
          <a class="btn btn-whatsapp !min-h-12" href={whatsappLink(locations[0])} data-cta="whatsapp">Message on WhatsApp</a>
        </div>
        <p class="mt-6 text-[0.85rem] text-faint">Open {locations[0].hoursDisplay}</p>
      </div>
    </div>
  </section>

  <!-- ============ THREE CENTRES ============ -->
  <section class="section border-t border-hairline bg-night">
    <div class="container-page">
      <SectionHeading
        eyebrow="Visit a centre"
        title="Our three centres"
        lead="Hyderabad (Kukatpally), Bengaluru (Sadashiva Nagar) and Mumbai (Prabhadevi)."
        class="mb-10 max-w-3xl"
      />
      <div class="grid gap-6 lg:grid-cols-3">
        {locations.map((loc) => (
          <div class="card reveal overflow-hidden">
            <ClickToLoadMap loc={loc} class="!rounded-none !border-0 !border-b" />
            <div class="p-6">
              <p class="eyebrow">{loc.locality}</p>
              <h3 class="mt-2.5 font-display text-[1.5rem]">
                {loc.city}
              </h3>
              <address class="mt-3 not-italic text-[0.92rem] leading-relaxed text-faint">
                {loc.streetAddress},<br />{loc.city}, {loc.state} {loc.postalCode}
              </address>
              <p class="mt-2 text-[0.86rem] text-faint">{loc.landmark}</p>
              <p class="mt-3 text-[0.86rem] text-faint">{loc.hoursDisplay}</p>
              <p class="mt-1 text-[0.86rem] text-faint">In {loc.languages.join(', ')}</p>

              <div class="mt-5 grid gap-2">
                <a class="btn btn-gold !min-h-11 !text-[0.85rem]" href={telLink(loc)} data-cta="call">{loc.phoneDisplay}</a>
                <a class="btn btn-whatsapp !min-h-11 !text-[0.85rem]" href={whatsappLink(loc)} data-cta="whatsapp">WhatsApp this centre</a>
                <a class="btn btn-ghost !min-h-11 !text-[0.85rem]" href={loc.mapUrl} target="_blank" rel="noopener">Get directions</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
