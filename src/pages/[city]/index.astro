---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ClickToLoadMap from '@/components/ClickToLoadMap.astro';
import ReviewBlock from '@/components/ReviewBlock.astro';
import CtaBand from '@/components/CtaBand.astro';
import StickyMobileCTA from '@/components/StickyMobileCTA.astro';
import Ornament from '@/components/Ornament.astro';
import AnswerBlock from '@/components/AnswerBlock.astro';
import { locations, pandit, brand, telLink, whatsappLink, abs } from '@/data/business';
import {
  buildGraph, organizationSchema, personSchema,
  localBusinessSchema, faqSchema, breadcrumbSchema,
} from '@/lib/schema';

export const getStaticPaths = (() =>
  locations.map((loc) => ({ params: { city: loc.slug }, props: { loc } }))
) satisfies GetStaticPaths;

const { loc } = Astro.props;

const allServices = (await getCollection('services', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const cityServices = allServices.filter((s) => loc.tier1Services.includes(s.id));
const otherServices = allServices.filter((s) => !loc.tier1Services.includes(s.id));

const url = abs(`/${loc.slug}/`);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: loc.city, url: `/${loc.slug}/` },
];

/* Hyderabad is the primary centre and the site homepage already owns the exact
   "best astrologer in hyderabad" term. To avoid two pages competing for it, the
   Hyderabad hub targets the Telugu + Kukatpally local variant instead. Other
   cities have no competing homepage, so they keep the broad "best astrologer" title. */
const pageTitle = loc.slug === 'hyderabad'
  ? `Telugu Astrologer in Hyderabad, ${loc.locality} | ${brand.shortName}`
  : `Best Astrologer in ${loc.city} - ${loc.locality} | ${brand.shortName}`;
const pageDescription = loc.slug === 'hyderabad'
  ? `Consult ${pandit.name}, a trusted Telugu astrologer in Hyderabad (Kukatpally) - jathakam & kundli matching, marriage, career and Vastu guidance in Telugu, Hindi or English. ${loc.hoursDisplay}. Call or WhatsApp.`
  : `Talk to ${pandit.name}, a trusted ${loc.languagePage?.language ?? 'Vedic'} astrologer in ${loc.city} (${loc.locality}) - kundli matching, jathakam, marriage, career & Vastu guidance. ${loc.hoursDisplay}. Call or WhatsApp.`;

/* Unique per-city FAQs. Deliberately NOT a template with the city name
   swapped - that pattern is what gets location pages filtered as doorways. */
const faqs = [
  {
    question: `Where exactly is your ${loc.city} centre?`,
    answer: `${loc.streetAddress}, ${loc.city} ${loc.postalCode}. ${loc.landmark}. Directions are on the map below, and you can call ${loc.phoneDisplay} if you need help finding it.`,
  },
  {
    question: `Do I need an appointment at the ${loc.city} centre?`,
    answer: `Not strictly, but it is worth calling ahead. If you send your birth details on WhatsApp before you come, the chart is prepared in advance and the whole consultation is spent on the discussion rather than the calculation.`,
  },
  {
    question: `Which languages are consultations held in at ${loc.city}?`,
    answer: `${loc.languages.join(', ')}. Discussing a chart in your own language matters - the distinctions are easy to lose in translation, particularly where a family alliance is being considered.`,
  },
  {
    question: `What are the timings for the ${loc.city} centre?`,
    answer: `${loc.hoursDisplay}. If you need a time outside these hours, call ${loc.phoneDisplay} and we will see what can be arranged.`,
  },
  {
    question: `Which areas of ${loc.city} do you see clients from?`,
    answer: `Most people travel to us from ${loc.areasServed.slice(0, 6).join(', ')} and the surrounding areas, though we consult with clients from across ${loc.city} and online from anywhere.`,
  },
  {
    question: `Can I consult online instead of visiting ${loc.city}?`,
    answer: `Yes. Consultations are held over call or video, and the same chart preparation applies. The only service that needs you in the room is palmistry, which cannot be read properly from a photograph.`,
  },
  {
    question: 'Can I get a Vastu consultation without a site visit?',
    answer: 'Yes. A floor-plan review works well for apartments and for properties you are considering buying - send the plan with the compass direction marked. A site visit gives a more complete assessment, but it is not the only option.',
  },
  {
    question: 'Does numerology replace a birth chart reading, or add to it?',
    answer: 'It adds to it. Numerology is offered alongside a chart reading as a second angle on a name or number question - it is not treated as a stand-alone system here.',
  },
  {
    question: 'Is Kundli matching for marriage done the same day?',
    answer: 'If both sides send their birth details in advance on WhatsApp, yes - the Ashtakoot or Porutham comparison is worked out before the appointment, so the session itself is spent discussing what it means rather than calculating it.',
  },
];

const jsonLd = buildGraph(
  organizationSchema(),
  personSchema(),
  localBusinessSchema(loc),
  faqSchema(faqs, url),
  breadcrumbSchema(crumbs),
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/${loc.slug}/`}
  jsonLd={jsonLd}
  hideStickyCta
>
  <div class="container-page pt-8"><Breadcrumbs crumbs={crumbs} /></div>

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden pb-14 pt-10">
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-40 text-gold">
      <Ornament variant="jaali" class="h-full w-full" />
    </div>

    <div class="container-page">
      <div class="grid items-start gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <p class="eyebrow enter">{loc.locality}, {loc.city}</p>
          <h1 class="display-lg enter enter-d1 mt-5">
            Best {loc.languagePage?.language ?? 'Vedic'} Astrologer in {loc.city}
          </h1>
          <p class="enter enter-d2 mt-6 text-lg leading-relaxed text-mist">
            {loc.intro}
          </p>

          <div class="enter enter-d3 mt-8 flex flex-wrap gap-3">
            <a class="btn btn-gold" href={telLink(loc)}>Call {loc.phoneDisplay}</a>
            <a class="btn btn-whatsapp" href={whatsappLink(loc)}>WhatsApp</a>
            <a class="btn btn-ghost" href={loc.mapUrl} target="_blank" rel="noopener">Get directions</a>
          </div>

          <dl class="enter enter-d4 mt-9 grid gap-4 border-t border-hairline pt-8 sm:grid-cols-2">
            <div>
              <dt class="dt">Address</dt>
              <dd class="dd">
                <address class="not-italic">{loc.streetAddress}, {loc.city}, {loc.state} {loc.postalCode}</address>
              </dd>
            </div>
            <div>
              <dt class="dt">Landmark</dt>
              <dd class="dd">{loc.landmark}</dd>
            </div>
            <div>
              <dt class="dt">Timings</dt>
              <dd class="dd">{loc.hoursDisplay}</dd>
            </div>
            <div>
              <dt class="dt">Languages</dt>
              <dd class="dd">{loc.languages.join(', ')}</dd>
            </div>
          </dl>
        </div>

        <div class="reveal lg:sticky lg:top-28">
          <ClickToLoadMap loc={loc} />
          <p class="mt-3 text-center text-[0.82rem] text-faint">
            The map loads only when you tap it - no third-party request before then.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ANSWER-FIRST (AEO) ============
       Targets the recommendation query family the Search Terms Report shows is
       real - "best astrologer hyderabad" (259 impr), "genuine astrologer in
       hyderabad", "best telugu astrologer in hyderabad". Written as one
       self-contained paragraph that still makes sense lifted out of the page,
       since that is the unit an assistant quotes. -->
  <AnswerBlock
    question={`Is there a good astrologer in ${loc.city}?`}
    answer={`${pandit.name} consults from ${loc.locality} in ${loc.city}, with more than ${pandit.yearsExperience} years of Vedic astrology practice. The centre offers kundali matching, birth chart readings, Vastu and Muhurtha, in ${loc.languages.join(', ')}. The centre is open ${loc.hoursDisplay}. Fees are quoted before booking, and no gemstones or remedy products are sold.`}
    facts={[
      { label: 'Astrologer', value: pandit.name },
      { label: 'Address', value: `${loc.streetAddress}, ${loc.city} ${loc.postalCode}` },
      { label: 'Landmark', value: loc.landmark },
      { label: 'Phone', value: loc.phoneDisplay },
      { label: 'Hours', value: loc.hoursDisplay },
      { label: 'Languages', value: loc.languages.join(', ') },
      { label: 'Areas served', value: loc.areasServed.slice(0, 6).join(', ') },
      { label: 'Also online', value: 'Consultations by call or video across India and abroad' },
    ]}
  />

  <!-- ============ WHY TRUSTED (E-E-A-T, unique per city) ============ -->
  {loc.whyTrusted && (
    <section class="section">
      <div class="container-page">
        <div class="mx-auto max-w-3xl">
          <SectionHeading
            eyebrow="30+ Years in Hyderabad"
            title={`Why families in ${loc.city} come to Pandit Ji`}
          />
          {loc.whyTrusted.split('\n\n').map((para) => (
            <p class="reveal mt-6 text-lg leading-relaxed text-mist">{para}</p>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ HOW A VISIT WORKS ============ -->
  <section class="section">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <SectionHeading
          eyebrow="Before you come in"
          title={`How a visit to the ${loc.city} centre actually works`}
        />
        <ol class="reveal mt-7 grid gap-5">
          <li>
            <p class="dt">1. Send your birth details ahead</p>
            <p class="dd mt-1">Call or WhatsApp {loc.phoneDisplay} with date, time and place of birth. There is nothing else to prepare.</p>
          </li>
          <li>
            <p class="dt">2. The chart is worked out before you arrive</p>
            <p class="dd mt-1">It is not generated on the spot from software while you wait - it is prepared in advance, so the appointment itself is spent on the conversation.</p>
          </li>
          <li>
            <p class="dt">3. A 45-60 minute session</p>
            <p class="dd mt-1">In person at {loc.locality} or over video, in {loc.languages.join(', ')}. You ask what you came to ask; nothing is rushed toward a remedy.</p>
          </li>
          <li>
            <p class="dt">4. What you leave with</p>
            <p class="dd mt-1">A clear verbal explanation, and where corrections or remedies are genuinely indicated, a written summary in order of priority - not thirty suggestions at once.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES HERE ============ -->
  <section class="section border-y border-hairline bg-night">
    <div class="container-page">
      <SectionHeading
        eyebrow={`At our ${loc.city} centre`}
        title={`What you can consult us about in ${loc.city}`}
        lead="Each of these has a dedicated page for this centre with local details and timings."
        class="mb-12"
      />

      <div class="mx-auto mb-12 grid max-w-3xl gap-6">
        <p class="reveal leading-relaxed text-mist">
          <strong class="text-cream">Marriage compatibility and Kundli matching</strong> is what most
          families come in for first - both sides' charts read together, not just a Guna score in
          isolation, whether your family follows Ashtakoot or the South Indian Porutham system.
        </p>
        <p class="reveal leading-relaxed text-mist">
          <strong class="text-cream">Birth chart and Kundli readings</strong> cover career timing,
          marriage prospects and family questions - the same reading, whether you come with a specific
          worry or want the full picture.
        </p>
        <p class="reveal leading-relaxed text-mist">
          <strong class="text-cream">Vastu consultations</strong> are available as a site visit or a
          floor-plan review, which suits most apartments well. Corrections are given in order of what
          genuinely matters, not a list of thirty changes - see the
          {' '}<a class="inline-link" href={`/${loc.slug}/vastu-for-home/`}>full Vastu page</a> for what an assessment covers.
        </p>
        <p class="reveal leading-relaxed text-mist">
          <strong class="text-cream">Numerology</strong> is offered alongside a chart reading, not as a
          replacement for one - it adds a second angle on a name or a number, it does not stand alone.
        </p>
        <p class="reveal leading-relaxed text-mist">
          <strong class="text-cream">Palmistry</strong> is in-person only. A photograph loses the depth
          and texture the method depends on, so this is the one service that cannot be done online.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {cityServices.map((s) => (
          <ServiceCard
            title={s.data.title}
            summary={s.data.summary}
            href={`/${loc.slug}/${s.id}/`}
            icon={s.data.icon}
          />
        ))}
      </div>

      <div class="mt-12">
        <h3 class="reveal font-display text-[1.3rem]">
          Also available at this centre
        </h3>
        <p class="reveal mt-4 leading-relaxed text-faint">
          {otherServices.map((s, i) => (
            <>
              <a class="inline-link" href={`/services/${s.id}/`}>{s.data.title}</a>
              {i < otherServices.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      </div>
    </div>
  </section>

  <!-- ============ COMMON MISCONCEPTIONS (cross-cluster AEO) ============ -->
  <section class="section border-y border-hairline bg-night">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <SectionHeading
          eyebrow="Before you worry"
          title="Questions families usually get wrong before they come in"
        />
        <div class="reveal mt-7 grid gap-6">
          <div>
            <p class="dt">Vastu does not mean breaking walls</p>
            <p class="dd mt-1">Most concerns in modern homes, especially apartments, are addressed through placement and direction rather than demolition. Structural change is a last resort, not a first suggestion.</p>
          </div>
          <div>
            <p class="dt">A difficult period is not a catastrophe</p>
            <p class="dd mt-1">Charts contain both favourable and difficult periods, and both are described accurately. A hard dasha being presented as an emergency, or an expensive ritual as the only way through it, is a warning sign about who is telling you that - not about your chart.</p>
          </div>
          <div>
            <p class="dt">A Mangal Dosha finding is rarely the whole story</p>
            <p class="dd mt-1">It is one of the most over-stated findings in Indian astrology. Classical texts list several cancellation conditions, and many charts flagged manglik by an app or a quick reading carry at least one. Bring the chart and we will tell you what is actually there.</p>
          </div>
          <div>
            <p class="dt">Numerology adds a second angle - it does not replace the chart</p>
            <p class="dd mt-1">A name or number correction is not treated as a stand-alone fix for a career or a relationship. It sits alongside a birth chart reading, not instead of one.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AREAS SERVED ============ -->
  <section class="section">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <SectionHeading
          eyebrow="Getting here"
          title={`Areas of ${loc.city} we commonly see clients from`}
        />
        <p class="reveal mt-6 leading-relaxed text-mist">
          Clients travel to the {loc.locality} centre from {loc.areasServed.slice(0, -1).join(', ')} and {loc.areasServed.at(-1)}.
          {' '}{loc.landmark}. If you are coming for the first time and are unsure of the approach,
          call {loc.phoneDisplay} and we will talk you in.
        </p>
        {loc.slug === 'hyderabad' && (
          <>
            <p class="reveal mt-5 leading-relaxed text-mist">
              Clients from the IT corridor - Madhapur, Hitech City, Gachibowli and Kondapur - tend to ask
              about career timing more than any other question, and a good number of them prefer a video
              consultation over a visit given the distance.
            </p>
            <p class="reveal mt-5 leading-relaxed text-mist">
              KPHB, Nizampet and Miyapur are the core walk-in base for this centre, and marriage matters -
              compatibility, timing, a family alliance under discussion - are what most of that group comes in for.
            </p>
          </>
        )}
        {loc.languagePage && (
          <p class="reveal mt-5 leading-relaxed text-mist">
            Consultations here are frequently held in {loc.languagePage.language} -
            see <a class="inline-link" href={`/${loc.slug}/${loc.languagePage.slug}/`}>{loc.languagePage.label}</a>.
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  <section class="section border-y border-hairline bg-night">
    <div class="container-page">
      <SectionHeading
        eyebrow="Client Experiences"
        title={`From clients at our ${loc.city} centre`}
        align="center"
        class="mb-12"
      />
      <ReviewBlock city={loc.slug} limit={6} />
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <SectionHeading
          eyebrow="Questions"
          title={`Visiting the ${loc.city} centre`}
          lead={`Anything not covered here - call ${loc.phoneDisplay}.`}
        />
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </section>

  <CtaBand city={loc.slug} title={`Speak to Pandit Ji in ${loc.city}`} />
  <StickyMobileCTA city={loc.slug} />
</BaseLayout>

<style>
  .dt {
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-gold);
  }
  .dd { margin-top: 0.35rem; font-size: 0.93rem; line-height: 1.6; color: var(--color-mist); }
  .inline-link {
    color: var(--color-gold);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-gold) 70%, transparent);
    text-underline-offset: 3px;
  }
</style>
