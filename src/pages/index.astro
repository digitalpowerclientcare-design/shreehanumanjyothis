---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CosmicBackground from '@/components/CosmicBackground.astro';
import ZodiacWheel from '@/components/ZodiacWheel.astro';
import AnswerBlock from '@/components/AnswerBlock.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ReviewBlock from '@/components/ReviewBlock.astro';
import { brand, pandit, locations, telLink, whatsappLink, abs } from '@/data/business';
import {
  buildGraph, organizationSchema, websiteSchema, personSchema,
  localBusinessSchema, faqSchema,
} from '@/lib/schema';

const services = (await getCollection('services', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const featured = services.slice(0, 6);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const faqs = [
  {
    question: 'Who is Pandit Sri Pandu Ranga Shastri Ji?',
    answer:
      'Pandit Sri Pandu Ranga Shastri Ji is a Vedic astrologer and Vastu consultant with more than three decades of practice. He consults from three centres — Sadashiva Nagar in Bengaluru, Kukatpally in Hyderabad, and Prabhadevi in Mumbai — offering Kundli analysis, marriage compatibility, Vastu and traditional remedial guidance.',
  },
  {
    question: 'How much does an astrology consultation cost?',
    answer:
      'Fees depend on the type of consultation and whether a site visit is involved. The figure is always shared before anything is booked, and nothing is added afterwards. Message any centre on WhatsApp and you will get a straight answer before you commit to anything.',
  },
  {
    question: 'What details do I need to bring to a consultation?',
    answer:
      'Your date of birth, your time of birth as accurately as you know it, and your place of birth. For a compatibility reading, the same three for both people. Send them on WhatsApp beforehand and the chart will be prepared before you arrive.',
  },
  {
    question: 'What if I do not know my exact birth time?',
    answer:
      'You have two options. Birth-time rectification narrows the likely time using known life events, though it is approximate. Or use Prasna Jyotish, which answers one specific question from the moment it is asked and needs no birth details at all.',
  },
  {
    question: 'Can I consult online instead of visiting a centre?',
    answer:
      'Yes. Consultations are held over call or video for clients anywhere in India and abroad. The one exception is palmistry, which needs the hand in front of the reader — a photograph loses the depth and texture the method depends on.',
  },
  {
    question: 'Do you guarantee results?',
    answer:
      'No, and we would ask you to be careful with anyone who does. A chart shows tendencies and timing indications. It does not determine what happens, and no remedy makes a specific outcome certain. Remedies are suggested only where the chart indicates them, and always with the reasoning explained.',
  },
];

const jsonLd = buildGraph(
  organizationSchema(true),
  websiteSchema(),
  personSchema(),
  ...locations.map(localBusinessSchema),
  faqSchema(faqs, abs('/')),
);

const marqueeItems = [
  'Kundli Matching', 'Jataka Porutham', 'Birth Chart Reading', 'Vastu Shastra',
  'Muhurtha', 'Prasna Jyotish', 'Career Guidance', 'Navagraha Shanti',
];

const steps = [
  { n: '01', t: 'Share your birth details', d: 'Date, time and place of birth — on WhatsApp or over the phone. Nothing else is needed.' },
  { n: '02', t: 'Your chart is prepared', d: 'Worked out before your appointment, so the session is spent on the discussion, not the calculation.' },
  { n: '03', t: 'The consultation', d: '45–60 minutes, in person at one of three centres or over video. In the language you are most comfortable in.' },
  { n: '04', t: 'Clear, honest guidance', d: 'What the chart shows, what it does not, and remedies only where they are genuinely indicated.' },
];
---

<BaseLayout
  title={`${brand.name} | Vedic Astrologer in Bengaluru, Hyderabad & Mumbai`}
  description="Vedic astrology consultations with Pandit Sri Pandu Ranga Shastri Ji — Kundli matching, birth chart analysis, Vastu and traditional guidance. Three centres: Sadashiva Nagar, Kukatpally and Prabhadevi."
  canonicalPath="/"
  jsonLd={jsonLd}
>

  <!-- ══════════════════════ HERO ══════════════════════ -->
  <section class="hero">
    <CosmicBackground intensity="hero" constellations />

    <div class="container-page relative z-10">
      <div class="hero-grid">

        <!-- Copy -->
        <div class="hero-copy">
          <p class="eyebrow enter">Since 1994 · Three Centres Across India</p>

          <h1 class="display-hero enter enter-d1">
            Read the sky.<br />
            <span class="text-gold-grad">Understand</span> your life.
          </h1>

          <p class="lead enter enter-d2 mt-6 max-w-lg">
            Kundli matching, birth-chart readings and Vastu with
            <strong class="font-semibold text-[--color-cream]">{pandit.name}</strong>.
            Thirty years of practice, explained plainly — no guarantees, no fear, no pressure.
          </p>

          <div class="enter enter-d3 mt-8 flex flex-wrap gap-3">
            <a class="btn btn-gold" href={whatsappLink(locations[0])}>
              Book a reading
              <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                <path d="M1 6h11M8.5 1.5 13 6l-4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a class="btn btn-ghost" href="/how-a-consultation-works/">How it works</a>
          </div>
        </div>

        <!-- Trust pills. Their own grid child so that on mobile the portrait
             can sit between the CTAs and the pills rather than below both. -->
        <div class="hero-pills enter enter-d4">
          {[
            `${pandit.yearsExperience}+ years of practice`,
            '5 languages',
            'In person or online',
          ].map((t) => <span class="pill">{t}</span>)}
        </div>

        <!-- Portrait + wheel.
             The portrait is a circular medallion sized as a fixed fraction of
             the wheel and sharing its centre, so the two are concentric by
             construction. An arch or rectangle floating over a rotating
             circular graphic can never look aligned — the geometry disagrees. -->
        <div class="hero-visual enter enter-d2">
          <div class="wheel-stage">
            <div class="wheel-wrap float-soft">
              <ZodiacWheel />
            </div>

            <figure class="portrait">
              <img
                src="/images/pandit-ji-1.webp"
                alt={`${pandit.name}, Vedic astrologer, at his consultation centre`}
                width="1024" height="768"
                fetchpriority="high" decoding="async"
              />
            </figure>

            <!-- Stat chips sit outside the outer ring so they never collide
                 with the rotating sign names. -->
            <span class="chip chip-1">
              <b data-count="30" data-count-suffix="+">30+</b>
              <i>years</i>
            </span>
            <!-- Not counted up: animating 3 from zero is imperceptible and
                 leaves "0 centres" on screen during first paint. -->
            <span class="chip chip-2">
              <b>3</b>
              <i>centres</i>
            </span>
          </div>

          <figcaption class="portrait-caption">
            <span class="caps text-[--color-gold]">Pandit</span>
            <span class="block font-display text-[1.6rem] leading-tight text-[--color-cream]">
              Sri Pandu Ranga Shastri Ji
            </span>
          </figcaption>
        </div>

      </div>
    </div>

    <div class="hero-fade"></div>
  </section>

  <!-- ══════════════════════ ANSWER-FIRST (AEO) ══════════════════════
       Sits immediately after the hero, inside the first 30% of page text,
       where 44.2% of LLM citations are drawn from. Written to answer the
       recommendation queries the Search Terms Report actually shows —
       "best astrologer hyderabad", "genuine astrologer in hyderabad",
       "best telugu astrologer in hyderabad" — as one liftable paragraph. -->
  <AnswerBlock
    question="Who is Pandit Sri Pandu Ranga Shastri Ji?"
    answer={`${pandit.name} is a Vedic astrologer and Vastu consultant with more than ${pandit.yearsExperience} years of practice. He consults in person from three centres — Sadashiva Nagar in Bengaluru, Kukatpally in Hyderabad and Prabhadevi in Mumbai — and online across India and abroad, in Telugu, Kannada, Hindi, Marathi and English. Fees are shared before any booking, and remedies are suggested only where a chart indicates them.`}
    facts={[
      { label: 'Practice', value: `Vedic astrology & Vastu, ${pandit.yearsExperience}+ years` },
      { label: 'Centres', value: locations.map((l) => `${l.city} (${l.locality})`).join(' · ') },
      { label: 'Languages', value: 'Telugu, Kannada, Hindi, Marathi, English' },
      { label: 'Formats', value: 'In person at any centre, or online by call/video' },
      { label: 'Main services', value: 'Kundali matching, birth chart reading, Vastu, Muhurtha' },
      { label: 'Fees', value: 'Quoted before booking; no gemstones or products sold' },
    ]}
  />

  <!-- ══════════════════════ MARQUEE ══════════════════════ -->
  <div class="marquee-band">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee-track" aria-hidden="true">
          {marqueeItems.map((m) => (
            <span class="marquee-item">
              <span class="marquee-dot"></span>{m}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ══════════════════════ CENTRES ══════════════════════ -->
  <section class="section relative">
    <CosmicBackground />
    <div class="container-page relative z-10">
      <header class="section-head">
        <p class="eyebrow reveal-fade">Our Centres</p>
        <h2 class="display-xl reveal mt-5">
          Three places to sit across<br class="hidden md:block" />
          from <span class="text-gold-grad">Pandit Ji</span>
        </h2>
        <p class="lead reveal mt-6 max-w-xl">
          Each centre keeps its own timings and its own phone line. Walk in, or send your
          birth details ahead and the chart will be ready.
        </p>
      </header>

      <div class="mt-16 grid gap-5 lg:grid-cols-3 stagger">
        {locations.map((loc, i) => (
          <article class="centre-card panel spotlight">
            <span class="centre-index">{String(i + 1).padStart(2, '0')}</span>

            <h3 class="font-display text-[2.1rem] leading-none text-[--color-cream]">
              <a href={`/${loc.slug}/`} class="after:absolute after:inset-0 after:content-['']">
                {loc.city}
              </a>
            </h3>
            <p class="caps mt-3 text-[--color-gold]">{loc.locality}</p>

            <address class="mt-6 not-italic text-[0.92rem] leading-relaxed text-[--color-mist]">
              {loc.streetAddress}<br />{loc.city} {loc.postalCode}
            </address>
            <p class="mt-3 text-[0.86rem] text-[--color-faint]">{loc.landmark}</p>

            <dl class="centre-meta">
              <div><dt>Timings</dt><dd>{loc.hoursDisplay}</dd></div>
              <div><dt>Languages</dt><dd>{loc.languages.join(' · ')}</dd></div>
            </dl>

            <div class="relative z-10 mt-7 flex flex-wrap gap-2">
              <a class="btn btn-gold !min-h-10 !px-4 !text-[0.8rem]" href={telLink(loc)}>{loc.phoneDisplay}</a>
              <a class="btn btn-ghost !min-h-10 !px-4 !text-[0.8rem]" href={loc.mapUrl} target="_blank" rel="noopener">Directions</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════ FEATURE BAND ══════════════════════ -->
  <section class="feature-band">
    <div class="feature-media">
      <img
        src="/images/pandit-ji-2.webp"
        alt={`${pandit.name} speaking at an event`}
        width="1024" height="768"
        loading="lazy" decoding="async"
        class="parallax-slow"
      />
      <div class="feature-scrim"></div>
    </div>

    <div class="feature-copy">
      <p class="eyebrow reveal-fade">The approach</p>
      <h2 class="display-lg reveal mt-5">
        Guidance that tells you what the chart<br class="hidden lg:block" />
        shows — <span class="text-gold-grad">and what it doesn't</span>
      </h2>
      <p class="lead reveal mt-6">
        Charts contain difficult periods as well as favourable ones, and both get described
        accurately. What does not happen here is a difficult period being presented as a
        catastrophe, or an expensive ritual positioned as the only thing standing between
        a family and misfortune.
      </p>
      <p class="lead reveal mt-4">
        We do not sell gemstones, yantras or remedy products. Where something is genuinely
        indicated you are told what it is, and you buy it wherever you like.
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-3">
        <a class="btn btn-gold" href="/about-pandit-ji/">About Pandit Ji</a>
        <a class="btn btn-ghost" href="/faq/">Read the FAQ</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ SERVICES ══════════════════════ -->
  <section class="section relative">
    <CosmicBackground />
    <div class="container-page relative z-10">
      <header class="section-head">
        <p class="eyebrow reveal-fade">Consultations</p>
        <h2 class="display-xl reveal mt-5">
          What families come<br class="hidden md:block" /> to us <span class="text-gold-grad">about</span>
        </h2>
        <p class="lead reveal mt-6 max-w-xl">
          Twenty consultations, available at all three centres and online.
          These are the six people ask for most.
        </p>
      </header>

      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 stagger">
        {featured.map((s, i) => (
          <article class="svc-card panel spotlight">
            <div class="svc-top">
              <span class="svc-icon"><ServiceIcon name={s.data.icon} size={24} /></span>
              <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
            </div>

            <h3 class="mt-7 font-display text-[1.6rem] leading-tight text-[--color-cream]">
              <a href={`/services/${s.id}/`} class="after:absolute after:inset-0 after:content-['']">
                {s.data.title}
              </a>
            </h3>

            <p class="mt-3.5 text-[0.93rem] leading-relaxed text-[--color-mist]">
              {s.data.summary}
            </p>

            <span class="svc-more">
              Explore
              <svg width="13" height="11" viewBox="0 0 13 11" fill="none" aria-hidden="true">
                <path d="M1 5.5h10M7.5 1.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </article>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a class="btn btn-ghost reveal" href="/services/">View all 20 consultations</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ PROCESS ══════════════════════ -->
  <section class="section relative overflow-hidden">
    <CosmicBackground />
    <div class="container-page relative z-10">
      <div class="grid gap-16 lg:grid-cols-[0.85fr_1.15fr]">
        <header>
          <p class="eyebrow reveal-fade">How it works</p>
          <h2 class="display-xl reveal mt-5">
            Four steps,<br /><span class="text-gold-grad">no mystery</span>
          </h2>
          <p class="lead reveal mt-6">
            Fees are shared before anything is booked, and nothing is added afterwards.
          </p>
          <a class="btn btn-gold reveal mt-8" href="/contact/">Send your birth details</a>
        </header>

        <ol class="steps stagger">
          {steps.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <div>
                <h3 class="font-display text-[1.5rem] leading-tight text-[--color-cream]">{s.t}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-[--color-mist]">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ══════════════════════ REVIEWS ══════════════════════ -->
  <section class="section relative">
    <CosmicBackground />
    <div class="container-page relative z-10">
      <header class="section-head text-center">
        <p class="eyebrow reveal-fade mx-auto">Client Experiences</p>
        <h2 class="display-xl reveal mx-auto mt-5">
          What people say <span class="text-gold-grad">afterwards</span>
        </h2>
      </header>
      <div class="mt-14">
        <ReviewBlock limit={3} />
      </div>
    </div>
  </section>

  <!-- ══════════════════════ FAQ ══════════════════════ -->
  <section class="section relative">
    <CosmicBackground />
    <div class="container-page relative z-10">
      <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr]">
        <header>
          <p class="eyebrow reveal-fade">Questions</p>
          <h2 class="display-xl reveal mt-5">
            Asked <span class="text-gold-grad">most often</span>
          </h2>
          <p class="lead reveal mt-6">
            Including the ones people are usually too polite to ask.
          </p>
          <a class="btn btn-ghost reveal mt-8" href="/faq/">See all questions</a>
        </header>
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </section>

  <!-- ══════════════════════ ARTICLES ══════════════════════ -->
  {posts.length > 0 && (
    <section class="section relative">
      <CosmicBackground />
      <div class="container-page relative z-10">
        <header class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow reveal-fade">Articles</p>
            <h2 class="display-xl reveal mt-5">Explained <span class="text-gold-grad">plainly</span></h2>
          </div>
          <a class="btn btn-ghost reveal shrink-0" href="/blog/">All articles</a>
        </header>

        <div class="grid gap-5 md:grid-cols-3 stagger">
          {posts.map((p) => (
            <article class="post-card panel spotlight">
              <time class="caps text-[--color-gold]" datetime={p.data.publishDate.toISOString()}>
                {p.data.publishDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
              <h3 class="mt-4 font-display text-[1.5rem] leading-tight text-[--color-cream]">
                <a href={`/blog/${p.id}/`} class="after:absolute after:inset-0 after:content-['']">{p.data.title}</a>
              </h3>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-[--color-mist]">{p.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════ FINAL CTA ══════════════════════ -->
  <section class="final-cta">
    <CosmicBackground intensity="hero" constellations />
    <div class="container-page relative z-10 text-center">
      <div class="cta-wheel" aria-hidden="true"><ZodiacWheel /></div>

      <p class="eyebrow reveal-fade mx-auto">Begin</p>
      <h2 class="display-hero reveal mx-auto mt-6 max-w-4xl">
        Your chart is already<br /><span class="text-gold-grad">written</span>
      </h2>
      <p class="lead reveal mx-auto mt-7 max-w-xl">
        Send your date, time and place of birth. You will get a clear explanation of what
        it shows — and an honest account of what it cannot tell you.
      </p>

      <div class="reveal mt-10 grid gap-3 sm:grid-cols-3 sm:gap-4">
        {locations.map((l) => (
          <a class="cta-city glass spotlight" href={`/${l.slug}/`}>
            <span class="font-display text-[1.7rem] leading-none text-[--color-cream]">{l.city}</span>
            <span class="mt-1.5 block text-[0.78rem] text-[--color-faint]">{l.locality}</span>
            <span class="mt-3 block text-[0.86rem] font-semibold text-[--color-gold]">{l.phoneDisplay}</span>
          </a>
        ))}
      </div>

      <p class="reveal mt-9 text-[0.86rem] text-[--color-faint]">
        Consultations in English, Telugu, Kannada, Hindi and Marathi · In person or online
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ════════════════ HERO ════════════════ */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 5vw, 7rem) clamp(5rem, 3rem + 6vw, 9rem);
    overflow: hidden;
  }
  .hero-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 14rem;
    background: linear-gradient(180deg, transparent, var(--color-void));
    pointer-events: none;
  }

  /* Mobile: copy → portrait → pills, so the photograph appears while the
     headline is still on screen instead of being pushed below the pills.
     Desktop: two columns, with the portrait spanning both rows. */
  .hero-grid {
    display: grid;
    gap: 2.75rem;
    grid-template-areas:
      'copy'
      'visual'
      'pills';
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.02fr 0.98fr;
      grid-template-rows: auto auto;
      grid-template-areas:
        'copy   visual'
        'pills  visual';
      gap: 2.5rem 3rem;
      align-items: center;
    }
  }
  .hero-copy   { grid-area: copy; }
  .hero-visual { grid-area: visual; }
  .hero-pills  { grid-area: pills; display: flex; flex-wrap: wrap; gap: 0.65rem; }

  .hero-copy h1 { margin-top: 1.5rem; }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.045);
    border: 1px solid var(--color-hairline);
    font-size: 0.79rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-mist);
    backdrop-filter: blur(8px);
  }

  /* — Portrait + wheel composition — */
  .hero-visual {
    /* One variable drives both the wheel and the medallion, so they can never
       drift out of proportion with each other. */
    --wheel: min(100%, 31rem);

    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  @media (max-width: 1023px) { .hero-visual { --wheel: min(94%, 25rem); } }

  .wheel-stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    max-width: calc(var(--wheel) * 1.24);   /* headroom for the chips */
  }

  .wheel-wrap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0.92;
  }
  .wheel-wrap :global(.wheel) { width: var(--wheel); }

  /* 0.53 lands the medallion just inside the wheel's innermost ring. */
  .portrait {
    position: relative;
    z-index: 2;
    width: calc(var(--wheel) * 0.53);
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-gold) 55%, transparent),
      0 0 0 8px rgb(4 5 10 / 0.92),
      0 0 0 9px color-mix(in srgb, var(--color-gold) 22%, transparent),
      0 30px 70px -22px rgb(0 0 0 / 0.95);
  }
  .portrait img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 54% 26%;   /* centres the face in the circle */
    display: block;
  }

  .portrait-caption { text-align: center; }

  /* — Floating chips — */
  .chip {
    position: absolute;
    z-index: 3;
    display: grid;
    justify-items: center;
    padding: 0.85rem 1.1rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-deep) 82%, transparent);
    border: 1px solid var(--color-hairline-strong);
    backdrop-filter: blur(14px);
    box-shadow: 0 20px 44px -22px rgb(0 0 0 / 0.9);
  }
  .chip b {
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-gold-bright);
  }
  .chip i {
    font-style: normal;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
