---
import { reviews, reviewsByCity, type ClientReview } from '@/data/reviews';
import { locations, getLocation, type CitySlug } from '@/data/business';

interface Props {
  city?: CitySlug;
  limit?: number;
}
const { city, limit = 6 } = Astro.props;

const list: ClientReview[] = (city ? reviewsByCity(city) : reviews).slice(0, limit);
const loc = city ? getLocation(city) : null;

// Only ever show a rating/count we can send the reader to verify.
const verifiable = loc && loc.gbpUrl && loc.reviews.count !== null;
---

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {list.map((r) => (
    <figure class="card reveal flex flex-col p-6">
      <span class="stars" aria-label="5 out of 5">
        {Array.from({ length: 5 }).map(() => (
          <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"/>
          </svg>
        ))}
      </span>

      <blockquote class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">
        {r.text}
      </blockquote>

      <figcaption class="mt-5 border-t border-line pt-4 text-[0.85rem]">
        <span class="font-semibold text-ink">{r.name}</span>
        <span class="mt-0.5 block text-muted">
          {r.area ? `${r.area}, ` : ''}{locations.find((l) => l.slug === r.city)?.city} · {r.service}
        </span>
      </figcaption>
    </figure>
  ))}
</div>

{verifiable ? (
  <p class="mt-8 text-center text-[0.9rem] text-muted">
    Rated {loc!.reviews.rating} from {loc!.reviews.count} reviews ·{' '}
    <a class="font-semibold text-maroon underline underline-offset-4" href={loc!.gbpUrl} target="_blank" rel="noopener">
      Read them on Google
    </a>
  </p>
) : (
  <p class="mt-8 text-center text-[0.9rem] text-muted">
    {/* Deliberate: no review count is claimed until it links to a live profile. */}
    Read every review on our Google Business Profile — link coming from the client.
  </p>
)}

<style>
  .stars { display: inline-flex; gap: 0.15rem; color: var(--color-gold); }
</style>
