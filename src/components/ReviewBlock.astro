---
import { reviews, reviewsByCity, type ClientReview } from '@/data/reviews';
import { locations, getLocation, type CitySlug } from '@/data/business';

interface Props {
  city?: CitySlug;
  limit?: number;
}
const { city, limit = 6 } = Astro.props;

const list: ClientReview[] = (city ? reviewsByCity(city) : reviews).slice(0, limit);
const loc = city ? getLocation(city) : null;
const primary = getLocation('hyderabad');

// The rating/count we can send the reader to verify. Prefer the page's own city;
// on city-neutral pages (homepage) fall back to the primary Hyderabad profile.
const verifyLoc =
  loc && loc.gbpUrl && loc.reviews.count !== null
    ? loc
    : !city && primary.gbpUrl && primary.reviews.count !== null
      ? primary
      : null;
// A profile to link to even when no count is claimed (e.g. an unverified city page).
const linkLoc = verifyLoc ?? (primary.gbpUrl ? primary : null);
---

{list.length > 0 && (
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {list.map((r) => (
      <figure class="card reveal flex flex-col p-6">
        <span class="stars" aria-label={`${r.rating} out of 5`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class={i < r.rating ? '' : 'star-muted'}>
              <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"/>
            </svg>
          ))}
        </span>

        <blockquote class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-mist">
          {r.text}
        </blockquote>

        <figcaption class="mt-5 border-t border-hairline pt-4 text-[0.85rem]">
          <span class="font-semibold text-cream">{r.name}</span>
          <span class="mt-0.5 block text-faint">
            {r.area ? `${r.area}, ` : ''}{locations.find((l) => l.slug === r.city)?.city} · {r.service}
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
)}

{verifyLoc ? (
  <p class="mt-8 text-center text-[0.9rem] text-faint">
    Rated {verifyLoc.reviews.rating} from {verifyLoc.reviews.count!.toLocaleString('en-IN')} reviews ·{' '}
    <a class="font-semibold text-gold underline underline-offset-4" href={verifyLoc.gbpUrl} target="_blank" rel="noopener">
      Read them on Google
    </a>
  </p>
) : linkLoc ? (
  <p class="mt-8 text-center text-[0.9rem] text-faint">
    <a class="font-semibold text-gold underline underline-offset-4" href={linkLoc.gbpUrl} target="_blank" rel="noopener">
      Read our reviews on Google
    </a>
  </p>
) : null}

<style>
  .stars { display: inline-flex; gap: 0.15rem; color: var(--color-gold); }
  .star-muted { color: var(--color-hairline, rgba(255,255,255,0.18)); }
</style>
