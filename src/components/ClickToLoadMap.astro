---
import type { Location } from '@/data/business';

/**
 * Click-to-load map. An eagerly-loaded Google Maps iframe is one of the
 * heaviest LCP killers on mobile, and the homepage needs three of them.
 * This renders a lightweight styled placeholder and swaps in the iframe only
 * on interaction — no third-party request until the user asks for one, which
 * is also the privacy-preserving default.
 */
interface Props { loc: Location; class?: string }
const { loc, class: className = '' } = Astro.props;
const id = `map-${loc.slug}`;
---

<div class={`map-shell ${className}`}>
  <button class="map-placeholder" data-map-trigger={id} type="button">
    <span class="jaali-bg" aria-hidden="true"></span>
    <span class="map-pin" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
      </svg>
    </span>
    <span class="map-label">
      <strong>{loc.locality}, {loc.city}</strong>
      <span>Tap to load the map</span>
    </span>
  </button>

  <template data-map-embed={id}>
    <iframe
      src={loc.mapEmbedUrl}
      title={`Map showing our ${loc.city} centre in ${loc.locality}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </template>
</div>

<script>
  // ~15 lines, the only meaningful JS on the page.
  document.querySelectorAll<HTMLButtonElement>('[data-map-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.mapTrigger;
      const tpl = document.querySelector<HTMLTemplateElement>(`[data-map-embed="${id}"]`);
      if (!tpl) return;
      btn.replaceWith(tpl.content.cloneNode(true));
    }, { once: true });
  });
</script>

<style>
  .map-shell {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-night);
  }
  .map-shell :global(iframe) {
    width: 100%; height: 100%; border: 0; display: block;
  }

  .map-placeholder {
    position: relative;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 0.75rem;
    width: 100%; height: 100%;
    padding: 1.5rem;
    background: none; border: 0; cursor: pointer;
    text-align: center;
    transition: background-color 0.3s ease;
  }
  .map-placeholder:hover { background: color-mix(in srgb, var(--color-gold) 8%, transparent); }

  .jaali-bg {
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--color-gold) 28%, transparent) 0 1px, transparent 1px 16px),
      repeating-linear-gradient(-45deg, color-mix(in srgb, var(--color-gold) 28%, transparent) 0 1px, transparent 1px 16px);
    mask-image: radial-gradient(ellipse at center, #000 25%, transparent 78%);
  }

  .map-pin {
    position: relative;
    display: grid; place-items: center;
    width: 3.25rem; height: 3.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-elevated);
    color: var(--color-gold);
    box-shadow: 0 10px 26px -14px rgb(122 46 42 / 0.55);
  }
  @media (prefers-reduced-motion: no-preference) {
    .map-placeholder:hover .map-pin { animation: pin-bob 1.1s var(--ease-in-out-soft) infinite; }
  }
  @keyframes pin-bob {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -5px; }
  }

  .map-label { position: relative; display: grid; gap: 0.15rem; }
  .map-label strong {
    font-family: var(--font-display);
    font-size: 1.02rem; font-weight: 600; color: var(--color-cream);
  }
  .map-label span { font-size: 0.82rem; color: var(--color-faint); }
</style>
