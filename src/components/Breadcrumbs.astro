---
import type { Crumb } from '@/lib/schema';

interface Props {
  crumbs: Crumb[];
  /** Use on dark sections. */
  light?: boolean;
}
const { crumbs, light = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`breadcrumbs ${light ? 'is-light' : ''}`}>
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 ? (
          <a href={c.url}>{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
        {i < crumbs.length - 1 && (
          <svg width="6" height="9" viewBox="0 0 6 9" fill="none" aria-hidden="true">
            <path d="M1 1l3.5 3.5L1 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { font-size: 0.8rem; }
  .breadcrumbs ol {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.5rem; list-style: none; margin: 0; padding: 0;
  }
  .breadcrumbs li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .breadcrumbs a { color: var(--color-muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color-maroon); text-decoration: underline; text-underline-offset: 3px; }
  .breadcrumbs span[aria-current] { color: var(--color-ink); font-weight: 550; }
  .breadcrumbs svg { color: color-mix(in srgb, var(--color-muted) 55%, transparent); }

  .is-light a { color: #b8b1c6; }
  .is-light a:hover { color: #fff; }
  .is-light span[aria-current] { color: #fff; }
</style>
