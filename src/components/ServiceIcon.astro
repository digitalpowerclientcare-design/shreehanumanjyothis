---
/**
 * Distinct line icons per service. Deliberately NOT one repeated glyph —
 * the audited site used the same Om mark three times for three different
 * "why choose us" cards, which reads as visual laziness.
 */
interface Props { name?: string; size?: number }
const { name = 'lotus', size = 22 } = Astro.props;
const s = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none' as const };
const stroke = { stroke: 'currentColor', 'stroke-width': '1.4', 'stroke-linecap': 'round' as const, 'stroke-linejoin': 'round' as const };
---

{name === 'chart' && (
  <svg {...s}><rect x="3" y="3" width="18" height="18" rx="1.5" {...stroke}/><path d="M3 3l18 18M21 3L3 21M12 3v18M3 12h18" {...stroke}/></svg>
)}
{name === 'rings' && (
  <svg {...s}><circle cx="9" cy="14" r="6" {...stroke}/><circle cx="15" cy="14" r="6" {...stroke}/><path d="M9 8V4l2-1.5L13 4v4" {...stroke}/></svg>
)}
{name === 'heart' && (
  <svg {...s}><path d="M12 20s-7-4.6-7-9.6A4 4 0 0 1 12 7a4 4 0 0 1 7 3.4c0 5-7 9.6-7 9.6z" {...stroke}/></svg>
)}
{name === 'house' && (
  <svg {...s}><path d="M3 10.5 12 3l9 7.5V21H3V10.5z" {...stroke}/><path d="M12 3v18M3 10.5h18" {...stroke}/><circle cx="12" cy="14" r="2" {...stroke}/></svg>
)}
{name === 'briefcase' && (
  <svg {...s}><rect x="2.5" y="7" width="19" height="13" rx="1.6" {...stroke}/><path d="M8.5 7V5.2A1.7 1.7 0 0 1 10.2 3.5h3.6A1.7 1.7 0 0 1 15.5 5.2V7M2.5 12.5h19" {...stroke}/></svg>
)}
{name === 'flame' && (
  <svg {...s}><path d="M12 21c3.3 0 6-2.4 6-5.5 0-4-4-5.5-4-9.5-2.5 1.5-3 4-3 5.5-1-.6-1.5-1.8-1.5-3C7.5 10 6 12.2 6 15.5 6 18.6 8.7 21 12 21z" {...stroke}/></svg>
)}
{name === 'snake' && (
  <svg {...s}><path d="M4 18c0-3 4-3 4-6s-4-3-4-6M20 18c0-3-4-3-4-6s4-3 4-6" {...stroke}/><circle cx="12" cy="12" r="1.6" {...stroke}/></svg>
)}
{name === 'clock' && (
  <svg {...s}><circle cx="12" cy="12" r="9" {...stroke}/><path d="M12 6.8V12l3.4 2.2" {...stroke}/></svg>
)}
{name === 'gem' && (
  <svg {...s}><path d="M6 3h12l3 6-9 12L3 9l3-6z" {...stroke}/><path d="M3 9h18M9 3l3 18M15 3l-3 18" {...stroke}/></svg>
)}
{name === 'numbers' && (
  <svg {...s}><path d="M9 3 7 21M17 3l-2 18M3.5 8.5h17M3 15.5h17" {...stroke}/></svg>
)}
{name === 'hand' && (
  <svg {...s}><path d="M8 12V5.5a1.5 1.5 0 1 1 3 0V11m0-.5V4.2a1.5 1.5 0 1 1 3 0V11m0-.5V6.2a1.5 1.5 0 1 1 3 0V14c0 4-2.5 7-6 7s-6-2.6-6-6v-3a1.5 1.5 0 1 1 3 0" {...stroke}/></svg>
)}
{name === 'question' && (
  <svg {...s}><circle cx="12" cy="12" r="9" {...stroke}/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.2 2.4c-.6.2-.7.7-.7 1.3v.3" {...stroke}/><circle cx="12" cy="17" r="0.9" fill="currentColor"/></svg>
)}
{name === 'sun' && (
  <svg {...s}><circle cx="12" cy="12" r="4.2" {...stroke}/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19" {...stroke}/></svg>
)}
{name === 'family' && (
  <svg {...s}><circle cx="8" cy="8" r="3" {...stroke}/><circle cx="16.5" cy="9.5" r="2.4" {...stroke}/><path d="M2.5 20c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5M15 14.4c3 0 6 1.7 6 5.6" {...stroke}/></svg>
)}
{name === 'lotus' && (
  <svg {...s}><path d="M12 20c-4.4 0-8-2.8-8-6.3 1.9 0 3.6.7 4.8 1.8M12 20c4.4 0 8-2.8 8-6.3-1.9 0-3.6.7-4.8 1.8" {...stroke}/><path d="M12 20c-2.6-2-4-4.5-4-7 0-3 1.6-5.6 4-7.6 2.4 2 4 4.6 4 7.6 0 2.5-1.4 5-4 7z" {...stroke}/></svg>
)}
