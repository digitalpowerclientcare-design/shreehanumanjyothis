---
import { brand } from '@/data/business';

/**
 * The client's actual logo. Orange/vermilion artwork on transparency, so it
 * sits correctly on the dark palette without a plate behind it.
 *
 * Canonical brand name is now "Shree Hanuman Jyothis" (matches domain + GBP).
 * NOTE: this raster wordmark still reads "SRI HANUMAN JYOTHISHALAYA" - the alt
 * text uses the canonical name, but the artwork itself needs updating.
 *
 * TODO(client): supply new logo artwork whose wordmark reads "Shree Hanuman
 * Jyothis" (ideally a vector original). This is a 1080×425 raster.
 */
interface Props {
  /** Larger treatment for the footer. */
  size?: 'header' | 'footer';
  class?: string;
}
const { size = 'header', class: className = '' } = Astro.props;
---

<img
  src="/images/logo-shj.png"
  alt={brand.name}
  width="1080"
  height="425"
  class={`logo logo-${size} ${className}`}
  loading={size === 'header' ? 'eager' : 'lazy'}
  fetchpriority={size === 'header' ? 'high' : undefined}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    width: auto;
    /* The artwork is on transparency and reads slightly hot against a near
       black field; a touch of brightness keeps the gold/orange from vibrating. */
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.55));
    transition: opacity 0.3s var(--ease-out-soft);
  }
  .logo:hover { opacity: 0.88; }

  .logo-header { height: 2.6rem; }
  @media (min-width: 768px) { .logo-header { height: 3.05rem; } }

  .logo-footer { height: 3.4rem; }
</style>
