---
import { brand } from '@/data/business';

// TODO(client): replace the mark with the real logo re-cut as SVG. The
// photograph watermark reads "SRI HANUMAN JYOTHISHALAYA" — worth confirming
// that as the canonical spelling across the site and all directories.
---

<span class="logo" aria-label={brand.name}>
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="lg-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#f7e6bd" />
          <stop offset="55%" stop-color="#d9ab5c" />
          <stop offset="100%" stop-color="#a67c33" />
        </linearGradient>
      </defs>
      <circle cx="24" cy="24" r="22.2" stroke="url(#lg-gold)" stroke-width="0.9" opacity="0.35" />
      <g class="logo-petals">
        {Array.from({ length: 8 }).map((_, i) => (
          <ellipse
            cx="24" cy="24" rx="4.4" ry="14"
            stroke="url(#lg-gold)" stroke-width="1" fill="none"
            transform={`rotate(${i * 22.5} 24 24)`}
            opacity="0.9"
          />
        ))}
      </g>
      <circle cx="24" cy="24" r="3.4" fill="url(#lg-gold)" />
    </svg>
  </span>

  <span class="logo-type">
    <span class="logo-line-1">Sri Hanuman</span>
    <span class="logo-line-2">Jyothishalaya</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.75rem; }

  .logo-mark { display: block; width: 2.5rem; height: 2.5rem; flex-shrink: 0; }
  .logo-mark svg { width: 100%; height: 100%; }
  .logo-petals { transform-origin: 24px 24px; transition: rotate 0.9s var(--ease-out-soft); }
  .logo:hover .logo-petals { rotate: 45deg; }

  .logo-type { display: grid; line-height: 1.1; }
  .logo-line-1 {
    font-family: var(--font-display);
    font-size: 1.16rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: linear-gradient(100deg, #f7e6bd, #d9ab5c 60%, #f2dca6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .logo-line-2 {
    font-family: var(--font-sans);
    font-size: 0.575rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-cream) 62%, transparent);
  }

  @media (max-width: 330px) { .logo-type { display: none; } }
</style>
